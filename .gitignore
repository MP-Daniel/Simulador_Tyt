# ==============================================================================
# GITIGNORE - SIMULADOR SABER TYT (UNIPUTUMAYO)
# Protección estricta de credenciales, temporales y cachés
# ==============================================================================

# Variables de entorno y credenciales (CRÍTICO)
.env
.env.local
.env.*.local
*.env

# Pero mantener siempre la plantilla
!.env.example

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Caches y temporales de Python
*.cache
.pytest_cache/

# Entornos virtuales
venv/
env/
.venv/
ENV/

# Base de datos SQLite local (en caso de pruebas)
*.sqlite3
*.db

# macOS files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# IDEs y Editores
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backups y temporales
*.bak
*.tmp
